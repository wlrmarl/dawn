<section class="sec" id="proof" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv">
      <div class="proof">
        <div class="proof-l">
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:12px">{{ section.settings.heading | newline_to_br }}</h2>
          <p class="body-s" style="max-width:40ch">{{ section.settings.text }}</p>
          <a class="btn btn-primary" href="{{ section.settings.button_url }}">{{ section.settings.button_label }}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          </a>
        </div>
        <div class="glass-2 rot" id="rot" aria-hidden="true">
          <div class="frame">
            {% for block in section.blocks %}
              {% if block.type == 'product_slide' %}
                {% if block.settings.product != blank %}
                  <img class="pimg {% if forloop.first %}on{% endif %}" 
                       src="{{ block.settings.product.featured_image | image_url: width: 400 }}" 
                       alt="{{ block.settings.product.title | escape }}" 
                       data-name="{{ block.settings.product.title | escape }}" 
                       data-note="{{ block.settings.note }}"
                       style="height:100%; object-fit:contain;" loading="lazy" {{ block.shopify_attributes }}>
                {% else %}
                  <span class="pimg {{ block.settings.css_class_fallback }} {% if forloop.first %}on{% endif %}" role="img" aria-label="{{ block.settings.alt_fallback }}" data-name="{{ block.settings.product_name_fallback }}" data-note="{{ block.settings.note }}" {{ block.shopify_attributes }}></span>
                {% endif %}
              {% endif %}
            {% endfor %}
          </div>
          <div class="cap"><b>Kitchen cleaner</b><span>Foam lifts grease, no scrubbing</span></div>
          <div class="dots">
            {% for block in section.blocks %}
              {% if block.type == 'product_slide' %}
              <i class="{% if forloop.first %}on{% endif %}"></i>
              {% endif %}
            {% endfor %}
          </div>
        </div>
      </div>
      <div class="glass-2 stats proof-stats" style="grid-column:1/-1">
        {% for block in section.blocks %}
          {% if block.type == 'stat' %}
          <div class="stat" {{ block.shopify_attributes }}>
            <div class="ring">{{ block.settings.value }}</div>
            <h5>{{ block.settings.title }}</h5>
            <p>{{ block.settings.text }}</p>
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Proof",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Why it works"
    },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Tough on grime.\nGentle on everything else."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Every formula is built on plant-derived cleansers and essential oils. It behaves exactly like the cleaner you are used to, minus the things you never signed up for."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "See the ingredient list"
    },
    {
      "type": "url",
      "id": "button_url",
      "label": "Button URL"
    }
  ],
  "blocks": [
    {
      "type": "product_slide",
      "name": "Product Slide",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "text",
          "id": "note",
          "label": "Note",
          "default": "Foam lifts grease, no scrubbing"
        },
        {
          "type": "header",
          "content": "Fallback if Product is empty"
        },
        {
          "type": "text",
          "id": "css_class_fallback",
          "label": "CSS Class",
          "default": "p-kitchen"
        },
        {
          "type": "text",
          "id": "product_name_fallback",
          "label": "Product Name",
          "default": "Kitchen cleaner"
        },
        {
          "type": "text",
          "id": "alt_fallback",
          "label": "Alt Text",
          "default": "Purelane foaming kitchen cleaner"
        }
      ]
    },
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "99.9%"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Germ kill"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Tested against germs and bacteria"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Proof",
      "blocks": [
        { "type": "product_slide", "settings": { "css_class_fallback": "p-kitchen", "product_name_fallback": "Kitchen cleaner", "note": "Foam lifts grease, no scrubbing" } },
        { "type": "product_slide", "settings": { "css_class_fallback": "p-tap", "product_name_fallback": "Tap & limescale", "note": "Melts hard water stains" } },
        { "type": "stat", "settings": { "value": "99.9%", "title": "Germ kill", "text": "Tested against germs and bacteria" } },
        { "type": "stat", "settings": { "value": "100%", "title": "Plant based", "text": "Cleansers derived from plants" } }
      ]
    }
  ]
}
{% endschema %}
