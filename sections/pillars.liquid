<section class="sec" id="how" data-scene="2">
  <div class="wrap">
    <div class="pillars">
      {% for block in section.blocks %}
      <article class="glass pillar rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}">
        <span class="pi">
          {{ block.settings.svg_code }}
        </span>
        <h3 class="d3">{{ block.settings.title }}</h3>
        <p class="body-s">{{ block.settings.text }}</p>
        <a class="btn btn-ghost btn-sm" href="{{ block.settings.button_url }}">{{ block.settings.button_label }}</a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Pillars",
  "tag": "section",
  "settings": [],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "html",
          "id": "svg_code",
          "label": "SVG Code"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Less scrubbing"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Learn more"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pillars",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Less scrubbing",
            "text": "A foaming formulation. The foam clings to grease and lifts it, so you wipe instead of scrub.",
