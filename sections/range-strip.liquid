<section class="sec" id="range" data-scene="3">
  <div class="wrap">
    <div class="glass range rv">
      <div class="range-head">
        <div>
          <span class="kicker">{{ section.settings.kicker }}</span>
          <h2 class="d2" style="margin-top:10px">{{ section.settings.heading }}</h2>
        </div>
        <p class="body-s" style="max-width:34ch;margin-bottom:4px">{{ section.settings.text }}</p>
      </div>
      <div class="stripwrap">
        <div class="rangerow">
          {% if section.settings.collection != blank %}
            {% for prod in section.settings.collection.products limit: section.settings.limit %}
              <img class="pimg" src="{{ prod.featured_image | image_url: width: 250 }}" alt="{{ prod.title | escape }}" loading="lazy" style="height:100%; object-fit:contain;">
            {% endfor %}
          {% else %}
            {% for block in section.blocks %}
              <span class="pimg {{ block.settings.css_class }}" role="img" aria-label="{{ block.settings.alt_text }}"></span>
            {% endfor %}
          {% endif %}
        </div>
      </div>
      <p class="striphint">{{ section.settings.hint }}</p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Range Strip",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "The full range"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every room, one shelf"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Floors, taps, kitchen, laundry, bathroom and hands. Fourteen plant-based formulas that replace every harsh bottle under your sink."
    },
    {
      "type": "text",
      "id": "hint",
      "label": "Hint",
      "default": "Swipe to see the full shelf"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection to display"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 4,
      "max": 20,
      "step": 1,
      "default": 10,
      "label": "Maximum products to show"
    }
  ],
  "blocks": [
    {
      "type": "product_image",
      "name": "Fallback Static Image",
      "settings": [
        {
          "type": "text",
          "id": "css_class",
          "label": "CSS Class",
          "default": "p-floor"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt Text",
          "default": "Purelane natural herbal floor cleaner"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Range Strip",
      "blocks": [
        { "type": "product_image", "settings": { "css_class": "p-floor", "alt_text": "Floor cleaner" } },
        { "type": "product_image", "settings": { "css_class": "p-tap", "alt_text": "Tap cleaner" } },
        { "type": "product_image", "settings": { "css_class": "p-kitchen", "alt_text": "Kitchen cleaner" } },
        { "type": "product_image", "settings": { "css_class": "p-toilet", "alt_text": "Toilet cleaner" } },
        { "type": "product_image", "settings": { "css_class": "p-laundry", "alt_text": "Laundry detergent" } },
        { "type": "product_image", "settings": { "css_class": "p-dish", "alt_text": "Dishwash gel" } }
      ]
    }
  ]
}
{% endschema %}
