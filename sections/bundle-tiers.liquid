<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.text }}</p>
      </div>
    </div>
    <div class="tiers">
      {% for block in section.blocks %}
      <article class="glass tier {% if block.settings.is_best %}best{% endif %} rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}" {{ block.shopify_attributes }}>
        <span class="tag">{{ block.settings.tag }}</span>
        
        <div class="tierpix {% if block.settings.products.count >= 5 %}five{% endif %}" aria-hidden="true">
          {% if block.settings.products != blank %}
            {% for prod in block.settings.products %}
              <img class="pimg" src="{{ prod.featured_image | image_url: width: 200 }}" alt="{{ prod.title | escape }}" style="height:100%; object-fit:contain;" loading="lazy">
            {% endfor %}
          {% else %}
            {{ block.settings.tierpix_html }}
          {% endif %}
        </div>
        
        <div class="qty">{{ block.settings.qty }}<small>Products</small></div>
        
        {% assign total_price = 0 %}
        {% assign total_compare = 0 %}
        {% for prod in block.settings.products %}
          {% assign total_price = total_price | plus: prod.price %}
          {% if prod.compare_at_price > prod.price %}
            {% assign total_compare = total_compare | plus: prod.compare_at_price %}
          {% else %}
            {% assign total_compare = total_compare | plus: prod.price %}
          {% endif %}
        {% endfor %}
        
        {% if block.settings.products != blank %}
          <div class="price">{{ total_price | money_without_trailing_zeros }} 
            {% if total_compare > total_price %}<s>{{ total_compare | money_without_trailing_zeros }}</s>{% endif %}
          </div>
        {% else %}
          <div class="price">{{ block.settings.price_fallback }} <s>{{ block.settings.compare_at_price_fallback }}</s></div>
        {% endif %}
        
        <p class="body-s" style="font-size:12px">{{ block.settings.per_product }}</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_1 }}</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_2 }}</li>
          {% if block.settings.bullet_3 != blank %}
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_3 }}</li>
          {% endif %}
        </ul>
        
        {% if block.settings.products != blank %}
          {% form 'product', block.settings.products.first %}
            <button type="submit" class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" style="width:100%; justify-content:center;">
              {{ block.settings.button_label }}
              {% if block.settings.is_best %}
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
              {% endif %}
            </button>
          {% endform %}
        {% else %}
          <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_url }}">
            {{ block.settings.button_label }}
            {% if block.settings.is_best %}
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
            {% endif %}
          </a>
        {% endif %}
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Tiers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Is Best Value?",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Select Products (for dynamic price & images)",
          "limit": 5
        },
        {
          "type": "html",
          "id": "tierpix_html",
          "label": "Fallback Pix HTML (if no products)",
          "default": "<span class=\"pimg p-combo2\" role=\"img\"></span>"
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity",
          "default": "2"
        },
        {
          "type": "text",
          "id": "price_fallback",
          "label": "Price (Fallback)",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_at_price_fallback",
          "label": "Compare at Price (Fallback)",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product",
          "label": "Per Product Text",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "bullet_1",
          "label": "Bullet 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "bullet_2",
          "label": "Bullet 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "bullet_3",
          "label": "Bullet 3"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Fallback Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Tiers",
      "blocks": [
        { "type": "tier", "settings": { "tag": "Starter", "qty": "2" } },
        { "type": "tier", "settings": { "tag": "Most popular", "qty": "3", "is_best": true } },
        { "type": "tier", "settings": { "tag": "Whole home", "qty": "5" } }
      ]
    }
  ]
}
{% endschema %}
