<section class="sec" id="bundles" data-scene="3">
  <div class="wrap">
    <div class="glass sec-pad rv" style="margin-bottom:16px">
      <div class="panel-head" style="margin-bottom:0">
        <span class="kicker">{{ section.settings.kicker }}</span>
        <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
        <p class="lede" style="margin:0 auto">{{ section.settings.text }}</p>
      </div>
    </div>
    <div class="tiers">
      {% for block in section.blocks %}
      <article class="glass tier {% if block.settings.is_best %}best{% endif %} rv {% if forloop.index == 2 %}rv-d2{% elsif forloop.index == 3 %}rv-d3{% endif %}">
        <span class="tag">{{ block.settings.tag }}</span>
        <div class="tierpix {% if block.settings.qty == '5' %}five{% endif %}" aria-hidden="true">
          {{ block.settings.tierpix_html }}
        </div>
        <div class="qty">{{ block.settings.qty }}<small>Products</small></div>
        <div class="price">{{ block.settings.price }} <s>{{ block.settings.compare_at_price }}</s></div>
        <p class="body-s" style="font-size:12px">{{ block.settings.per_product }}</p>
        <ul>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_1 }}</li>
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_2 }}</li>
          {% if block.settings.bullet_3 != blank %}
          <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>{{ block.settings.bullet_3 }}</li>
          {% endif %}
        </ul>
        <a class="btn {% if block.settings.is_best %}btn-primary{% else %}btn-ghost{% endif %}" href="{{ block.settings.button_url }}">
          {{ block.settings.button_label }}
          {% if block.settings.is_best %}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
          {% endif %}
        </a>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Tiers",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Build your bundle"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "One box. Every room."
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Mix and match across kitchen, laundry, home and skin. One flat price, no code needed, free shipping either way."
    }
  ],
  "blocks": [
    {
      "type": "tier",
      "name": "Tier",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_best",
          "label": "Is Best Value?",
          "default": false
        },
        {
          "type": "text",
          "id": "tag",
          "label": "Tag",
          "default": "Starter"
        },
        {
          "type": "html",
          "id": "tierpix_html",
          "label": "Tier Pix HTML",
          "default": "<span class=\"pimg p-combo2\" role=\"img\"></span>"
        },
        {
          "type": "text",
          "id": "qty",
          "label": "Quantity",
          "default": "2"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹349"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare at Price",
          "default": "₹598"
        },
        {
          "type": "text",
          "id": "per_product",
          "label": "Per Product Text",
          "default": "Flat ₹174 per product"
        },
        {
          "type": "text",
          "id": "bullet_1",
          "label": "Bullet 1",
          "default": "Pick any two products"
        },
        {
          "type": "text",
          "id": "bullet_2",
          "label": "Bullet 2",
          "default": "Free shipping across India"
        },
        {
          "type": "text",
          "id": "bullet_3",
          "label": "Bullet 3"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Build this box"
        },
        {
          "type": "url",
          "id": "button_url",
          "label": "Button URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Tiers"
    }
  ]
}
{% endschema %}
