<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {% if section.settings.collection != blank %}
        {% for product in section.settings.collection.products limit: section.settings.product_limit %}
          {% assign delay_index = forloop.index0 | modulo: 4 %}
          {% assign delay_class = '' %}
          {% if delay_index == 1 %}{% assign delay_class = 'rv-d1' %}{% endif %}
          {% if delay_index == 2 %}{% assign delay_class = 'rv-d2' %}{% endif %}
          {% if delay_index == 3 %}{% assign delay_class = 'rv-d3' %}{% endif %}
          {% render 'purelane-product-card', product: product, animation_delay: delay_class %}
        {% endfor %}
      {% else %}
        <p style="text-align: center; width: 100%;">Please select a collection in the theme editor to populate the grid.</p>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Shelf",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker text",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Headline",
      "default": "Loved by 30,000 homes"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Product Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 4,
      "max": 12,
      "step": 4,
      "default": 4,
      "label": "Maximum products to show"
    }
  ],
  "presets": [
    {
      "name": "Product Shelf"
    }
  ]
}
{% endschema %}
