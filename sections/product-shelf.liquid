<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    <div class="shelf">
      {% for block in section.blocks %}
      <article class="glass card rv {% if forloop.index == 2 %}rv-d1{% elsif forloop.index == 3 %}rv-d2{% elsif forloop.index == 4 %}rv-d3{% endif %}">
        <div class="shot">
          {% if block.settings.badge != blank %}
          <span class="pill">{{ block.settings.badge }}</span>
          {% endif %}
          {{ block.settings.image_html }}
        </div>
        <h4>{{ block.settings.title }}</h4>
        <div class="rate"><b>★ {{ block.settings.rating }}</b> · {{ block.settings.reviews }} reviews</div>
        <div class="pr">
          <strong>{{ block.settings.price }}</strong>
          {% if block.settings.compare_at_price != blank %}
          <s>{{ block.settings.compare_at_price }}</s>
          <em>{{ block.settings.discount }} off</em>
          {% endif %}
        </div>
        <button class="btn btn-ghost btn-sm">{{ block.settings.button_label }}</button>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Shelf",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bestsellers"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Loved by 30,000 homes"
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product Card",
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge",
          "default": "Best seller"
        },
        {
          "type": "html",
          "id": "image_html",
          "label": "Image HTML (SVG or CSS Class)",
          "default": "<span class=\"pimg p-tap\" role=\"img\"></span>"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Tap cleaner & limescale remover"
        },
        {
          "type": "text",
          "id": "rating",
          "label": "Rating",
          "default": "4.8"
        },
        {
          "type": "text",
          "id": "reviews",
          "label": "Reviews Count",
          "default": "237"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₹200"
        },
        {
          "type": "text",
          "id": "compare_at_price",
          "label": "Compare at Price",
          "default": "₹299"
        },
        {
          "type": "text",
          "id": "discount",
          "label": "Discount",
          "default": "33%"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Add to cart"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Shelf"
    }
  ]
}
{% endschema %}
