<section class="sec" id="categories" data-scene="4">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
    </div>
    <div class="cats">
      {% for block in section.blocks %}
      <a class="glass cat rv {% if forloop.index == 2 %}rv-d1{% elsif forloop.index == 3 %}rv-d2{% elsif forloop.index == 4 %}rv-d3{% endif %}" href="{{ block.settings.url }}">
        <span class="ph"><span class="pimg {{ block.settings.css_class }}" role="img"></span></span>
        <span class="txt">
          <h4>{{ block.settings.title }}</h4>
          <p>{{ block.settings.text }}</p>
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Bundle Categories",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Bundle categories"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Find the right bundle for you"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "text",
          "id": "css_class",
          "label": "CSS Class",
          "default": "p-kitchen"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen bundle"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Grease, dishes & more"
        },
        {
          "type": "url",
          "id": "url",
          "label": "URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Bundle Categories",
      "blocks": [
        { "type": "category", "settings": { "css_class": "p-kitchen", "title": "Kitchen bundle", "text": "Grease, dishes & more", "url": "#combos" } },
        { "type": "category", "settings": { "css_class": "p-toilet", "title": "Bathroom bundle", "text": "Deep clean & disinfect", "url": "#combos" } },
        { "type": "category", "settings": { "css_class": "p-laundry", "title": "Laundry bundle", "text": "Softer, fresher wash", "url": "#combos" } },
        { "type": "category", "settings": { "css_class": "p-tap", "title": "Hard water bundle", "text": "Melt away limescale", "url": "#combos" } }
      ]
    }
  ]
}
{% endschema %}
