<section class="sec" id="combos" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <h2 class="d2" style="margin-top:12px">{{ section.settings.heading }}</h2>
      <div class="rule"><i></i><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg><i></i></div>
      <p class="lede" style="margin:14px auto 0">{{ section.settings.text }}</p>
    </div>
    <div class="comborail rv">
      {% for block in section.blocks %}
      <article class="glass combo {% if block.settings.is_hero %}hero-combo{% endif %}" {{ block.shopify_attributes }}>
        <div class="tray">
          {% assign total_price = 0 %}
          {% assign total_compare = 0 %}
          {% for prod in block.settings.products %}
            {% assign total_price = total_price | plus: prod.price %}
            {% if prod.compare_at_price > prod.price %}
              {% assign total_compare = total_compare | plus: prod.compare_at_price %}
            {% else %}
              {% assign total_compare = total_compare | plus: prod.price %}
            {% endif %}
          {% endfor %}
          {% if total_compare > total_price %}
            {% assign save_amount = total_compare | minus: total_price | money_without_trailing_zeros %}
            <span class="save">You save {{ save_amount }}</span>
          {% endif %}
          
          {% if block.settings.flag_text != blank %}
          <span class="flag">{{ block.settings.flag_text }}</span>
          {% endif %}
          <div class="stack">
            {% for prod in block.settings.products %}
              <span class="it">
                <img class="pimg" src="{{ prod.featured_image | image_url: width: 200 }}" alt="{{ prod.title | escape }}" loading="lazy">
                <span>{{ prod.title }}</span>
              </span>
              {% unless forloop.last %}
              <span class="plus" aria-hidden="true">+</span>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        <div class="body">
          <h3>{{ block.settings.title }}</h3>
          <div class="cnt">{{ block.settings.products | size }} products</div>
          <p class="inc">{{ block.settings.includes_text }}</p>
          <div class="prow">
            <strong>{{ total_price | money_without_trailing_zeros }}</strong>
            {% if total_compare > total_price %}
              <s>{{ total_compare | money_without_trailing_zeros }}</s>
              <em>Save {{ save_amount }}</em>
            {% endif %}
          </div>
          <div class="fine">{{ block.settings.fine_print }}</div>
          {% form 'product', block.settings.products.first %}
            <button type="submit" class="btn {% if block.settings.is_hero %}btn-primary{% else %}btn-ghost{% endif %}">{{ block.settings.button_label }} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg></button>
          {% endform %}
        </div>
      </article>
      {% endfor %}
    </div>
    <div class="swipecue" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>Swipe for more combos</div>
    <p class="railnote">Tapping "Shop bundle" opens the bundle picker with these products already added. You can still swap anything before you pay.</p>
  </div>
</section>

{% schema %}
{
  "name": "Combo Rail",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "Pre-built to save you money"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Best selling combos"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Swipe through the boxes people order most. Each one is already priced below buying the same products on their own."
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo",
      "settings": [
        {
          "type": "checkbox",
          "id": "is_hero",
          "label": "Is Hero Combo?",
          "default": false
        },
        {
          "type": "text",
          "id": "flag_text",
          "label": "Flag Text (Optional)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Kitchen essentials"
        },
        {
          "type": "textarea",
          "id": "includes_text",
          "label": "Includes Text",
          "default": "Includes products for a sparkling kitchen, no need to pick separately."
        },
        {
          "type": "text",
          "id": "fine_print",
          "label": "Fine Print",
          "default": "Inclusive of all taxes & COD available"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop bundle"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products in Combo (Max 5)",
          "limit": 5
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Combo Rail",
      "blocks": [
        { "type": "combo", "settings": { "title": "Kitchen essentials", "flag_text": "Most popular" } },
        { "type": "combo", "settings": { "title": "Complete home bundle", "is_hero": true, "flag_text": "Best value" } }
      ]
    }
  ]
}
{% endschema %}
