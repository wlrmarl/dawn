<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker }}</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>{{ section.settings.rating }}</b> {{ section.settings.rating_text }}</span>
      <span class="agg">{{ section.settings.loved_by_text }} <b>{{ section.settings.loved_by_bold }}</b></span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% for block in section.blocks %}
      <article class="glass-2 rcard">
        <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <h5>{{ block.settings.title }}</h5>
        <p>{{ block.settings.text }}</p>
        <div class="who">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
          <b>{{ block.settings.author }}</b>
          <span>&middot; {{ block.settings.product }}</span>
        </div>
      </article>
      {% endfor %}
      {%- comment -%}Repeat for marquee effect{%- endcomment -%}
      {% for block in section.blocks %}
      <article class="glass-2 rcard">
        <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
        <h5>{{ block.settings.title }}</h5>
        <p>{{ block.settings.text }}</p>
        <div class="who">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
          <b>{{ block.settings.author }}</b>
          <span>&middot; {{ block.settings.product }}</span>
        </div>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Review Marquee",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker",
      "default": "That's what they said"
    },
    {
      "type": "text",
      "id": "rating",
      "label": "Rating",
      "default": "4.8"
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating Text",
      "default": "from 8,000+ reviews"
    },
    {
      "type": "text",
      "id": "loved_by_text",
      "label": "Loved by Text",
      "default": "Loved by"
    },
    {
      "type": "text",
      "id": "loved_by_bold",
      "label": "Loved by Bold",
      "default": "12 lakh+ homes"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Works like a charm"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Anita"
        },
        {
          "type": "text",
          "id": "product",
          "label": "Product",
          "default": "Laundry detergent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Review Marquee",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "text": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "author": "Anita", "product": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "text": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "author": "Priya", "product": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "text": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "author": "Sunita", "product": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "text": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "product": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "text": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "author": "Verified buyer", "product": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
