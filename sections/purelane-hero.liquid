<section class="hero" data-scene="1">
  <div class="hero-grid">

    <div class="badges glass-2" aria-label="Product promises">
      {% for block in section.blocks %}
        {% if block.type == 'trust_badge' %}
          <div class="badge" {{ block.shopify_attributes }}>
            <span class="bi">{{ block.settings.svg_icon }}</span>
            <span>{{ block.settings.title }}</span>
          </div>
        {% endif %}
      {% endfor %}
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading | newline_to_br }}</h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.text }}</p>
      <div class="hero-cta rv rv-d3">
        {% if section.settings.primary_label != blank %}
        <a class="btn btn-primary" href="{{ section.settings.primary_url }}">{{ section.settings.primary_label }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        {% endif %}
        {% if section.settings.secondary_label != blank %}
        <a class="btn btn-ghost" href="{{ section.settings.secondary_url }}">{{ section.settings.secondary_label }}</a>
        {% endif %}
      </div>

      <div class="badgestrip rv rv-d4">
        {% for block in section.blocks %}
          {% if block.type == 'trust_badge' %}
          <div class="glass-2">
            {{ block.settings.svg_icon }}
            {{ block.settings.title_inline }}
          </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {% assign slide_count = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'product_slide' %}
            {% assign slide_count = slide_count | plus: 1 %}
            {% assign prod_count = block.settings.products | size %}
            {% if prod_count == 0 %}{% assign prod_count = 1 %}{% endif %} <!-- Fallback to layout 1 if empty -->
            <div class="hslide hs{{ prod_count }} {% if slide_count == 1 %}on{% endif %}" data-n="{{ slide_count }}" {{ block.shopify_attributes }}>
              {% assign letter_classes = "a,b,c" | split: "," %}
              {% assign delay_classes = "d1,d2,d3" | split: "," %}
              {% for prod in block.settings.products %}
                {% assign idx = forloop.index0 %}
                <img class="hp {{ letter_classes[idx] }} {{ delay_classes[idx] }}" 
                     src="{{ prod.featured_image | image_url: width: 600 }}" 
                     alt="{{ prod.title }}" 
                     loading="eager"
                     style="height: 100%; width: auto; object-fit: contain;">
              {% endfor %}
              
              <div class="glass-2 ptag">
                <span class="lbl">{{ block.settings.slide_label }}</span>
                {% assign total_price = 0 %}
                {% assign total_compare = 0 %}
                {% for prod in block.settings.products %}
                  {% assign total_price = total_price | plus: prod.price %}
                  {% if prod.compare_at_price > prod.price %}
                    {% assign total_compare = total_compare | plus: prod.compare_at_price %}
                  {% else %}
                    {% assign total_compare = total_compare | plus: prod.price %}
                  {% endif %}
                {% endfor %}
                <span class="val">
                  <strong>{{ total_price | money_without_trailing_zeros }}</strong>
                  {% if total_compare > total_price %}
                    <s>{{ total_compare | money_without_trailing_zeros }}</s>
                  {% endif %}
                </span>
                {% if block.settings.discount_text != blank %}
                  <span class="cut">{{ block.settings.discount_text }}</span>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
      <div class="hdots" id="hdots">
        {% assign dot_index = 0 %}
        {% for block in section.blocks %}
          {% if block.type == 'product_slide' %}
            <button type="button" class="{% if dot_index == 0 %}on{% endif %}" aria-label="Show slide {{ dot_index | plus: 1 }}"></button>
            {% assign dot_index = dot_index | plus: 1 %}
          {% endif %}
        {% endfor %}
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Purelane Hero",
  "tag": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "heading",
      "label": "Heading",
      "default": "Clean\nThat\nLasts"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it."
    },
    {
      "type": "text",
      "id": "primary_label",
      "label": "Primary Button Label",
      "default": "Shop now"
    },
    {
      "type": "url",
      "id": "primary_url",
      "label": "Primary Button Link"
    },
    {
      "type": "text",
      "id": "secondary_label",
      "label": "Secondary Button Label",
      "default": "How it works"
    },
    {
      "type": "url",
      "id": "secondary_url",
      "label": "Secondary Button Link"
    }
  ],
  "blocks": [
    {
      "type": "trust_badge",
      "name": "Trust Badge",
      "limit": 3,
      "settings": [
        {
          "type": "html",
          "id": "svg_icon",
          "label": "SVG Icon Code (Paste raw SVG)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Badge Text (Desktop HTML allowed)",
          "default": "Plant<br>powered"
        },
        {
          "type": "text",
          "id": "title_inline",
          "label": "Badge Text (Mobile inline)",
          "default": "Plant powered"
        }
      ]
    },
    {
      "type": "product_slide",
      "name": "Product Slide",
      "limit": 3,
      "settings": [
        {
          "type": "text",
          "id": "slide_label",
          "label": "Top Label",
          "default": "Single bottle"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Select Products (Max 3)",
          "limit": 3
        },
        {
          "type": "text",
          "id": "discount_text",
          "label": "Discount Tag Text",
          "default": "33% off"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Hero",
      "blocks": [
        { "type": "trust_badge", "settings": { "svg_icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z\"/><path d=\"M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z\"/></svg>", "title": "Plant<br>powered", "title_inline": "Plant powered" } },
        { "type": "trust_badge", "settings": { "svg_icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z\"/><path d=\"m9 12 2.2 2.2L15.4 10\"/></svg>", "title": "Safe for<br>kids & pets", "title_inline": "Kids & pet safe" } },
        { "type": "trust_badge", "settings": { "svg_icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"12\" cy=\"12\" r=\"8.4\"/><path d=\"M6.4 17.6 17.6 6.4\"/></svg>", "title": "Zero harsh<br>chemicals", "title_inline": "Zero harsh chem" } },
        { "type": "product_slide", "settings": { "slide_label": "Single bottle" } },
        { "type": "product_slide", "settings": { "slide_label": "Any 2 products" } },
        { "type": "product_slide", "settings": { "slide_label": "Any 3 products" } }
      ]
    }
  ]
}
{% endschema %}
